[Unit]
Description=Airgap Mirror Agent
Documentation=https://github.com/ynw0/airgap-mirror
After=network.target
Wants=network.target

[Service]
Type=simple
User=airgap-mirror
Group=airgap-mirror
EnvironmentFile=/etc/airgap-mirror/agent.env
ExecStart=/usr/local/bin/mirror-agent \
  -listen 127.0.0.1:8787 \
  -db /var/lib/airgap-mirror/server.db \
  -staging /var/lib/airgap-mirror/transfer-staging \
  -exports /var/lib/airgap-mirror/state-exports \
  -maintenance /var/lib/airgap-mirror/maintenance
Restart=on-failure
RestartSec=3s
TimeoutStopSec=35s
UMask=0027

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
