# Installed as /etc/airgap-mirror/agent.env with mode 0640, owner root:airgap-mirror.
# Use a random value of at least 32 bytes. The installer generates one when this file does not exist.
AIRGAP_MIRROR_TOKEN=REPLACE_WITH_A_LONG_RANDOM_TOKEN
# Listen only locally until administrator enables access from the trusted LAN.
AIRGAP_MIRROR_LISTEN=127.0.0.1:8787
# Optional APT re-signing, configured by configure-apt-signing.sh.
# AIRGAP_MIRROR_GNUPGHOME=/var/lib/airgap-mirror/gnupg
# AIRGAP_MIRROR_APT_SIGNING_KEY=YOUR_FINGERPRINT
